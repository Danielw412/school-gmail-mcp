# Backend settings. The real file is ~/.config/school-email-sync/backend.env
# (mode 0600, outside Git). deploy/install-backend.sh creates it with fresh
# random secrets the first time; you normally never edit it by hand.

# Shared with Google Apps Script (Script Property SYNC_SECRET). Lets the caller
# ingest mail, poll outbound actions and report results.
# Generate with: school-email-sync gen-secret
SYNC_SECRET=

# For local tools only (search, read, queue send/reply). Must differ from
# SYNC_SECRET. Requests carrying it are refused through the Cloudflare tunnel.
API_SECRET=

# Loopback only. The backend refuses to start on any other address.
LISTEN_ADDR=127.0.0.1:8766

# Optional:
# DB_PATH=                      default: $STATE_DIRECTORY/mail.db (~/.local/state/school-email-sync/mail.db)
# ALLOW_REMOTE_CLIENT_API=false allow the client API through the tunnel (not recommended)
# ACTION_LEASE_SECONDS=600      how long Apps Script holds a claimed action before it is offered again
# ACTION_MAX_ATTEMPTS=5         attempts for temporary send failures
# LOG_LEVEL=info                debug | info | warn | error

# ChatGPT (MCP) endpoint, reached only through the OpenAI Secure MCP Tunnel:
# MCP_LISTEN_ADDR=127.0.0.1:8767   loopback only, not routed by Cloudflare; "off" disables MCP
# MCP_ALLOW_SEND=true              false = ChatGPT can only search and read
# MCP_SEND_DELAY_SECONDS=60        cancel window for mail queued through ChatGPT (0-900)

# Attachments (get_attachment): downloaded from Gmail on demand through Apps Script,
# converted in memory, never stored. See README "Attachments".
# ATTACHMENT_FETCH_URL=            Apps Script web app URL https://script.google.com/macros/s/<id>/exec;
#                                  empty = relay through the 1-minute sync trigger (no web app needed, slower)
# ATTACHMENT_FETCH_SECRET=         with ATTACHMENT_FETCH_URL: same value as the Script Property of that name
#                                  (school-email-sync gen-secret); must differ from SYNC_SECRET and API_SECRET
# ATTACHMENT_MAX_BYTES=10485760    largest attachment downloaded (1 KiB - 25 MiB)
# ATTACHMENT_FETCH_TIMEOUT_SECONDS=40    wait for Gmail (5-300)
# ATTACHMENT_CONVERT_TIMEOUT_SECONDS=15  text extraction / image conversion (5-300)
